WEBSITE_URL=http://localhost:3000 # Add the correct ENV var for this onto your hosting platform, point it to your production website.
ENVIRONMENT=development
PORT=3000

NEXT_PUBLIC_API_URL=http://localhost:1337
PREVIEW_SECRET=preview_secret

# Website lead form delivery.
# Local UI/UX mock: LEAD_FORM_DELIVERY=file writes JSONL submissions.
# Easiest email MVP: set RESEND_API_KEY, LEAD_FORM_EMAIL_FROM, and LEAD_FORM_EMAIL_TO.
# Google Sheets option: deploy a Google Apps Script web app that appends rows,
# then set LEAD_FORM_GOOGLE_SHEETS_WEBHOOK_URL to that URL.
LEAD_FORM_DELIVERY=file
LEAD_FORM_FILE_PATH=.tmp/leads.jsonl
RESEND_API_KEY=
LEAD_FORM_EMAIL_FROM=
LEAD_FORM_EMAIL_TO=
LEAD_FORM_GOOGLE_SHEETS_WEBHOOK_URL=
LEAD_FORM_WEBHOOK_URL=
